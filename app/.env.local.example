# Copy to `.env.local`. For local dev, point these at the STAGING Supabase
# project, not production — see docs/ENVIRONMENTS.md.

# Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth is configured in the Supabase dashboard under:
# Authentication > Providers > Google
# No client ID/secret needed here.

# Admin email — only this Google account can access /admin
ADMIN_EMAIL=you@gmail.com

# ─── Discord ────────────────────────────────────────────────────────────────
# Website "Continue with Discord" uses Supabase's Discord provider, configured
# in the dashboard under Authentication > Providers > Discord (no keys needed
# here for that path).
#
# The Discord Activity (iframe) path needs the app's own OAuth credentials,
# from https://discord.com/developers/applications/<app>/oauth2
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Secret used to sign the Activity session cookie. Generate with:
#   openssl rand -base64 32
DISCORD_ACTIVITY_SESSION_SECRET=your-random-32-byte-secret

# Public invite link to the community server, shown as the Discord icon in the
# site footer. Optional: the footer falls back to the live invite when unset;
# set this to override it. Example: https://discord.gg/abcd123
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ─── Discord bot (slash commands) ────────────────────────────────────────────
# Bot token from Developer Portal → <app> → Bot → Reset Token. Used to register
# slash commands and post the daily puzzle / manage the reminder role.
DISCORD_BOT_TOKEN=your-discord-bot-token
# App's Ed25519 public key, from Developer Portal → General Information. Used to
# verify incoming interaction webhooks at /api/discord/interactions.
DISCORD_PUBLIC_KEY=your-discord-public-key
# Optional: a test server ID so `npm run register-commands` registers there
# instantly (global commands take up to ~1h). Leave unset for global.
# DISCORD_GUILD_ID=your-test-server-id

# ─── Discord daily auto-post + opt-in reminders ──────────────────────────────
# Channel the daily puzzle is posted to (also where the opt-in button message
# lives). Enable Developer Mode in Discord, then right-click the channel →
# Copy Channel ID.
DISCORD_ANNOUNCE_CHANNEL_ID=your-announce-channel-id
# Self-assignable role @-mentioned in the daily post. Create the role, give the
# bot "Manage Roles", and keep this role BELOW the bot's role in
# Server Settings → Roles (the bot can only assign roles beneath its own).
# Members opt in via the button posted by `npm run setup-daily-optin`.
DISCORD_DAILY_ROLE_ID=your-daily-reminder-role-id

# ─── Cron (Vercel) ───────────────────────────────────────────────────────────
# Shared secret Vercel sends as `Authorization: Bearer <CRON_SECRET>` on cron
# invocations; the cron routes (/api/cron/daily-post, /api/cron/sync-puzzles)
# reject anything else. Use any random string and set the SAME value in the
# Vercel project's env vars.
#   openssl rand -hex 32
CRON_SECRET=your-random-cron-secret
# Puzzle sync pulls puzzles/*.json from the public repo at request time. These
# default to this repo on main; override only if that changes. GITHUB_TOKEN is
# optional (a public repo needs none) — it just lifts the API rate limit.
# PUZZLES_REPO=rakdcolon/puddle
# PUZZLES_BRANCH=main
# GITHUB_TOKEN=

# ─── GitHub → Discord patch notes ────────────────────────────────────────────
# /api/github/release posts a published GitHub Release's notes to #patch-notes.
# Configure a repo webhook (Settings → Webhooks): payload URL
# https://solvepuddle.com/api/github/release, content type application/json,
# events = "Releases" only, and this same secret. Then set both here and in
# Vercel.
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret
# Channel ID of #patch-notes (Developer Mode → right-click → Copy Channel ID).
# The bot needs View Channel / Send Messages / Embed Links there.
DISCORD_PATCHNOTES_CHANNEL_ID=your-patch-notes-channel-id
