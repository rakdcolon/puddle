# Store filled values in ignored app/.env.qa.local or Vercel Preview settings.
PUDDLE_ENV=qa
NEXT_PUBLIC_SUPABASE_URL=https://mzwzcdyteyrlnrwcetxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-qa-publishable-key
