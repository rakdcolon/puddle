{
  "name": "app",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "import-puzzle": "node scripts/import-puzzle.mjs",
    "sync-puzzles": "node scripts/sync-puzzles.mjs",
    "register-commands": "node scripts/register-commands.mjs",
    "setup-daily-optin": "node scripts/setup-daily-optin.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/with-env.mjs dev node_modules/vitest/vitest.mjs run --config vitest.live.config.mts",
    "test:e2e": "playwright test",
    "test:agent": "node --test ../automation/test/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:env": "node scripts/local-env.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.1",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": "22.x"
  }
}
